library(fs)
library(stringr)
library(yaml)
cat("\n==============================\n")
cat(" Docusaurus Link Fixer\n")
cat("==============================\n\n")
project <- "."
docs_dir  <- path(project, "docs")
pages_dir <- path(project, "src", "pages")
# -------------------------------------------------
# Build lookup table from markdown files
# -------------------------------------------------
docs <- dir_ls(
docs_dir,
recurse = TRUE,
regexp = "\\.md$"
)
lookup <- data.frame(
key = character(),
slug = character(),
stringsAsFactors = FALSE
)
for(f in docs){
txt <- readLines(f, warn = FALSE)
if(length(txt) < 3) next
if(txt[1] != "---") next
end <- which(txt[-1] == "---")[1] + 1
if(is.na(end)) next
front <- tryCatch(
yaml.load(
paste(txt[2:(end-1)], collapse="\n")
),
error=function(e) NULL
)
if(is.null(front)) next
if(is.null(front$slug)) next
filename <- tools::file_path_sans_ext(basename(f))
key <- tolower(gsub("[^A-Za-z0-9]", "", filename))
lookup <- rbind(
lookup,
data.frame(
key=key,
slug=paste0("/docs", front$slug),
stringsAsFactors=FALSE
)
)
}
cat("Loaded", nrow(lookup), "document slugs.\n\n")
# -------------------------------------------------
# Backup pages
# -------------------------------------------------
backup <- path(project, "backup_pages")
if(!dir_exists(backup))
dir_create(backup)
pages <- dir_ls(
pages_dir,
recurse=TRUE,
regexp="\\.(js|jsx)$"
)
for(page in pages){
file_copy(
page,
path(backup, path_file(page)),
overwrite=TRUE
)
}
cat("Backups created.\n\n")
# -------------------------------------------------
# Replace links
# -------------------------------------------------
pattern <- 'to="/docs/([^"]+)"'
total <- 0
for(page in pages){
txt <- read_file(page)
matches <- str_match_all(txt, pattern)[[1]]
if(nrow(matches)==0)
next
cat("\n", path_file(page), "\n")
for(i in seq_len(nrow(matches))){
full <- matches[i,1]
link <- matches[i,2]
last <- basename(link)
key <- tolower(gsub("[^A-Za-z0-9]", "", last))
hit <- lookup[lookup$key==key,]
if(nrow(hit)==1){
new <- paste0('to="', hit$slug, '"')
txt <- str_replace_all(
txt,
fixed(full),
new
)
cat("✓", full, " -> ", new, "\n")
total <- total + 1
} else {
cat("⚠ Could not match:", full, "\n")
}
}
write_file(txt,page)
}
